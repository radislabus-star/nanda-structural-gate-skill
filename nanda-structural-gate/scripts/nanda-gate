#!/usr/bin/env bash
set -euo pipefail
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" != /* ]] && script_path="$script_dir/$script_path"
done
script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
if [[ -x "$script_dir/../bin/nanda" ]]; then
  exec "$script_dir/../bin/nanda" gate "$@"
fi
manifest="$script_dir/../../Cargo.toml"
if [[ -f "$manifest" ]]; then
  exec cargo "+${NANDA_RUST_TOOLCHAIN:-1.97.0}" run --quiet --manifest-path "$manifest" -- gate "$@"
fi
echo "error: nanda binary missing and source manifest not found: $manifest" >&2
exit 2
